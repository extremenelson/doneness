#!/usr/bin/env bash
# ~/bin/wt-new
# wt-new <bead-id> [base-branch]: create a branch and a worktree for one bead.
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: wt-new <bead-id> [base-branch]" >&2
  exit 64
fi
id="$1"
base="${2:-main}"

common="$(git rev-parse --path-format=absolute --git-common-dir)"
root="$(dirname "$common")"
if [ "$(basename "$common")" = ".bare" ]; then
  dest="${root}/${id}"
else
  dest="${root}.wt/${id}"
  echo "WARN  not a container-layout repo; using ${root}.wt (convert with repo-adopt)"
fi

if [ -e "$dest" ]; then
  echo "FAIL  $dest already exists" >&2
  exit 1
fi

if git -C "$root" fetch --quiet origin 2>/dev/null; then
  echo "OK    fetched origin"
else
  echo "WARN  could not fetch origin; branching from local state"
fi

if git -C "$root" rev-parse --verify --quiet "origin/${base}" >/dev/null; then
  start="origin/${base}"
else
  start="$base"
  echo "WARN  origin/${base} not found; using local ${base}"
fi

mkdir -p "$(dirname "$dest")"
if git -C "$root" rev-parse --verify --quiet "refs/heads/${id}" >/dev/null; then
  git -C "$root" worktree add "$dest" "$id"
else
  # --no-track: the new branch must not adopt the base branch as its upstream.
  git -C "$root" worktree add --no-track -b "$id" "$dest" "$start"
fi

echo "OK    worktree ready: $dest"
echo "next: cd \"$dest\" && bd update \"$id\" --claim"
